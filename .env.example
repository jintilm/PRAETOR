# PRAETOR 部署配置（复制为 .env）
#
# 注意：本项目只读 PRAETOR_* 前缀。同一台机器上的其它栈（如旧 ARTEX 栈）
# 即使还在用 ARTEX_*，也不会被 PRAETOR 读取——两套栈配置完全隔离。

# ---- 部署栈 ----
PRAETOR_TAG=latest
# 独立 compose 项目（docker-compose.yml 已固定 name: praetor）
POSTGRES_USER=praetor
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=praetor

# 宿主端口：默认避开旧栈常用的 8787/8788
PRAETOR_HTTP_PORT=8797
PRAETOR_MCP_PORT=8798
# 宿主数据目录（含 jwt.key 等）；两套栈不要指向同一个目录
PRAETOR_DATA_DIR=./data

# ---- 沙箱（P0-6 接入后生效）----
# required（默认）= Docker 不可用即拒绝执行；optional = 允许降级到宿主并告警
PRAETOR_SANDBOX=required

# ---- LLM（二选一或都填；也可留空到 UI 里配）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PRAETOR_LLM_PROVIDER=
PRAETOR_LLM_MODEL=
PRAETOR_LLM_BASE_URL=
PRAETOR_LLM_PROXY=

# ---- 本地直接跑二进制时（不走 compose）----
# PRAETOR_PG_DSN=postgres://praetor:change-me-please@127.0.0.1:5432/praetor?sslmode=disable
# 领域包启用（逗号分隔，默认 pentest）
# PRAETOR_DOMAINS=pentest
